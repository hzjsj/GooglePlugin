{
  "manifest_version": 3,
  "name": "Request Filter Logger",
  "description": "Filter requests by selected interfaces and print matched request data to console.",
  "version": "1.1.0",
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Request Filter Logger"
  }
}
