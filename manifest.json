{
  "manifest_version": 3,
  "name": "Request Filter Logger",
  "description": "Filter network requests by configured endpoints and print matched requests to console.",
  "version": "1.0.0",
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Request Filter Logger"
  }
}
